<%- include("partials/header") %>
    <main>
      <section class="hero-section" id="home">
        <div class="container">
          <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-7">
              <span class="eyebrow"><i class="bi bi-plus-circle-fill" aria-hidden="true"></i> Your neighbourhood clinic in <%= area %></span>
              <h1><%= clinicName %><span class="hero-period">.</span></h1>
              <p class="hero-tagline"><%= tagline %></p>
              <p class="hero-copy">Personal, practical healthcare from a team that takes the time to listen. We’re here to help you and your family feel your best.</p>
              <a class="btn btn-primary btn-lg hero-button" href="/booking">Book an appointment <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
              <div class="hero-note"><i class="bi bi-clock" aria-hidden="true"></i> Open Monday to Saturday, 9am–9pm</div>
            </div>
            <div class="col-lg-5">
              <div class="hero-art" role="img" aria-label="Illustration of a caring medical professional">
                <div class="art-sun"></div>
                <div class="art-cross"><i class="bi bi-plus-lg" aria-hidden="true"></i></div>
                <div class="art-card">
                  <div class="art-icon"><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i></div>
                  <div><strong>Care you can count on</strong><span>Here for your health</span></div>
                  <i class="bi bi-check-circle-fill art-check" aria-hidden="true"></i>
                </div>
                <div class="art-circle art-circle-one"></div>
                <div class="art-circle art-circle-two"></div>
                <div class="art-leaf"><i class="bi bi-leaf-fill" aria-hidden="true"></i></div>
                <div class="art-stethoscope"><i class="bi bi-activity" aria-hidden="true"></i></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section specialties-section" id="specialties">
        <div class="container">
          <div class="section-heading text-center">
            <span class="eyebrow">Here for your wellbeing</span>
            <h2>Our Specialties</h2>
            <p>Expert support for the health needs that matter most to you.</p>
          </div>
          <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <div class="specialty-icon icon-blue"><i class="bi bi-person-heart" aria-hidden="true"></i></div>
                <h3>General Physician</h3>
                <p>Everyday care, check-ups, and guidance for your whole family.</p>
              </article>
            </div>
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <div class="specialty-icon icon-teal"><i class="bi bi-ear" aria-hidden="true"></i></div>
                <h3>ENT</h3>
                <p>Expert care for ear, nose, and throat concerns.</p>
              </article>
            </div>
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <div class="specialty-icon icon-coral"><i class="bi bi-emoji-smile" aria-hidden="true"></i></div>
                <h3>Dentist</h3>
                <p>Gentle dental care to help keep your smile healthy.</p>
              </article>
            </div>
            <div class="col-sm-6 col-lg-3">
              <article class="specialty-card">
                <div class="specialty-icon icon-lilac"><i class="bi bi-heart-pulse" aria-hidden="true"></i></div>
                <h3>Cardiologist</h3>
                <p>Heart health assessment, advice, and ongoing support.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="section about-section" id="about">
        <div class="container">
          <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-5">
              <div class="about-art" aria-hidden="true">
                <div class="about-art-inner">
                  <i class="bi bi-hospital-fill"></i>
                  <span>Good health starts with good care.</span>
                </div>
                <span class="about-spark about-spark-one"><i class="bi bi-stars"></i></span>
                <span class="about-spark about-spark-two"><i class="bi bi-plus-circle-fill"></i></span>
              </div>
            </div>
            <div class="col-lg-7">
              <span class="eyebrow">A little about us</span>
              <h2>Good care starts with listening.</h2>
              <p class="about-copy">At <%= clinicName %>, we believe healthcare should feel personal. Our friendly team brings together experienced clinicians and a thoughtful approach, so you can feel comfortable asking questions and confident in your care.</p>
              <p class="about-copy">Whether you’re here for a routine visit or a specific concern, we’ll work with you to find the right next step—right here in your neighbourhood.</p>
              <a class="text-link" href="#contact">Come and meet our team <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
          </div>
        </div>
      </section>

      <section class="section contact-section" id="contact">
        <div class="container">
          <div class="contact-panel">
            <div class="row g-5">
              <div class="col-lg-5">
                <span class="eyebrow">We’re easy to find</span>
                <h2>Let’s take care of you.</h2>
                <p>Get in touch to book your visit or ask our team a question.</p>
                <a class="btn btn-light contact-button" href="#contact-details"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i> Booking information</a>
              </div>
              <div class="col-lg-7" id="contact-details">
                <div class="contact-details">
                  <div class="contact-detail">
                    <span class="contact-icon"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></span>
                    <div><h3>Visit us</h3><p><%= address %></p></div>
                  </div>
                  <div class="contact-detail">
                    <span class="contact-icon"><i class="bi bi-telephone-fill" aria-hidden="true"></i></span>
                    <div><h3>Call us</h3><p><%= phone %></p></div>
                  </div>
                  <div class="contact-detail">
                    <span class="contact-icon"><i class="bi bi-clock-fill" aria-hidden="true"></i></span>
                    <div><h3>Opening hours</h3><p>Monday–Saturday: 9am–9pm<br>Sunday: Closed</p></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
<%- include("partials/footer") %>
