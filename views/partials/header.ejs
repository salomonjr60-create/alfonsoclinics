<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f9fc">
    <meta name="description" content="<%= clinicName %> offers friendly, expert medical care in <%= area %>.">
    <title><%= pageTitle %></title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/site.css" rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar navbar-expand-lg navbar-light" aria-label="Main navigation">
        <div class="container">
          <a class="navbar-brand d-flex align-items-center gap-2" href="<%= sectionBase %>#home" aria-label="<%= clinicName %> home">
            <span class="brand-mark" aria-hidden="true"><i class="bi bi-heart-pulse-fill"></i></span>
            <span><%= clinicName %><small><%= area %></small></span>
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="mainNavigation">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
              <li class="nav-item"><a class="nav-link" href="<%= sectionBase %>#home">Home</a></li>
              <li class="nav-item"><a class="nav-link" href="<%= sectionBase %>#specialties">Specialties</a></li>
              <li class="nav-item"><a class="nav-link" href="<%= sectionBase %>#about">About</a></li>
              <li class="nav-item"><a class="nav-link" href="<%= sectionBase %>#contact">Contact</a></li>
              <li class="nav-item"><a class="btn btn-primary nav-cta" href="/booking">Book an appointment</a></li>
              <% if (currentUser) { %>
                <li class="nav-item"><a class="nav-link" href="/my-appointments">My Appointments</a></li>
                <li class="nav-item">
                  <form action="/logout" method="post">
                    <button class="nav-link nav-link-button" type="submit">Logout</button>
                  </form>
                </li>
              <% } else { %>
                <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
                <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
              <% } %>
            </ul>
          </div>
        </div>
      </nav>
    </header>
